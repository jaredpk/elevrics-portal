{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "elevrics-portal",
  "main": "src/index.js",
  "compatibility_date": "2026-08-01",

  // Only public/ ships. The auto-generated config used ".", which tried to
  // upload the whole repo — including node_modules/workerd at 122 MiB, well
  // past the 25 MiB per-asset limit. Keeping the assets directory separate
  // from the repo root is what prevents that.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",

    // Required, not an optimisation choice. By default static assets are served
    // BEFORE the Worker runs, so a request to any host for "/" matches
    // public/index.html and returns the portal launcher without the Worker ever
    // executing — which silently bypasses the parked-host check and served the
    // internal launcher on the public pathfinder.elevrics.ai.
    // With this set, the Worker runs first and decides what to serve.
    "run_worker_first": true
  },

  "vars": {
    // Rollout state for portal-owned accounts. See src/auth/config.js — the
    // ordering constraint (portal auth → origins accept its assertion → Access
    // comes off) is why this is a flag and not a branch.
    //   access  — Cloudflare Access only, /auth/* not mounted
    //   shadow  — portal sessions live and displayed, Access still authoritative
    //   enforce — portal session required; Access can be removed
    // Committed as "shadow" deliberately: deploying this repo must never be the
    // thing that starts refusing requests.
    "AUTH_MODE": "shadow",

    // Absolute base for redirect URIs, the assertion `iss`, and the retired-host
    // redirect target. A var rather than derived from the request host, because
    // it must not be steerable by a Host header.
    "PORTAL_ORIGIN": "https://portal.elevrics.ai",

    // finance.elevrics.ai. "notice" serves the retirement page on the BARE
    // HOSTNAME only — deep links 301 straight through in both modes. Flip to
    // "redirect" when the announced window closes; see README.
    "RETIREMENT_MODE": "notice"
  },

  // Login state is a sealed cookie and the session is a sealed cookie, so this
  // binding is genuinely optional: without it, sign-in works and only global
  // revocation and the in-Worker rate-limit backstop are absent (both degrade
  // deliberately — see src/auth/session.js and src/auth/ratelimit.js).
  // Uncomment once the namespace exists:
  //   npx wrangler kv namespace create AUTH_KV
  // "kv_namespaces": [
  //   { "binding": "AUTH_KV", "id": "<id from the command above>" }
  // ],

  // Secrets — set with `npx wrangler secret put <NAME>`, never in this file:
  //   WORKOS_CLIENT_ID        AuthKit client id
  //   WORKOS_API_KEY          AuthKit secret key
  //   SESSION_SECRET          HKDF input for the session-cookie key (32+ bytes)
  //   ASSERTION_SIGNING_KEY   ES256 private JWK, JSON, for module assertions
  //   ASSERTION_SIGNING_KEY_NEXT   optional, published alongside during rotation

  "observability": {
    "enabled": true
  }
}
